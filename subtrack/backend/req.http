### REGISTER USER
POST http://localhost:5000/auth/register
Content-Type: application/json

{
  "name": "Anurag",
  "email": "anurag@example.com",
  "password": "password123"
}

### LOGIN USER
POST http://localhost:5000/auth/login
Content-Type: application/json

{
  "email": "anurag@example.com",
  "password": "password123"
}

### LOGOUT
POST http://localhost:5000/auth/logout

### GET CURRENT USER PROFILE
GET http://localhost:5000/users/profile
Authorization: Bearer <REPLACE_WITH_JWT_TOKEN>

### UPDATE USER PROFILE
PUT http://localhost:5000/users/profile/<USER_ID>
Authorization: Bearer <REPLACE_WITH_JWT_TOKEN>
Content-Type: application/json

{
  "name": "Anurag Updated",
  "reminderDays": 5
}

### CHANGE PASSWORD
PUT http://localhost:5000/users/change-password
Authorization: Bearer <REPLACE_WITH_JWT_TOKEN>
Content-Type: application/json

{
  "currentPassword": "password123",
  "newPassword": "newpassword123"
}

### ADD SUBSCRIPTION
POST http://localhost:5000/subscriptions
Authorization: Bearer <REPLACE_WITH_JWT_TOKEN>
Content-Type: application/json

{
  "serviceName": "Netflix",
  "category": "Entertainment",
  "price": 649,
  "billingCycle": "monthly",
  "renewalDate": "2026-11-15",
  "reminderDays": 3,
  "status": "active",
  "paymentMethod": "UPI",
  "notes": "Standard HD Plan"
}

### VIEW ALL SUBSCRIPTIONS
GET http://localhost:5000/subscriptions
Authorization: Bearer <REPLACE_WITH_JWT_TOKEN>

### VIEW SINGLE SUBSCRIPTION
GET http://localhost:5000/subscriptions/<SUBSCRIPTION_ID>
Authorization: Bearer <REPLACE_WITH_JWT_TOKEN>

### UPDATE SUBSCRIPTION
PUT http://localhost:5000/subscriptions/<SUBSCRIPTION_ID>
Authorization: Bearer <REPLACE_WITH_JWT_TOKEN>
Content-Type: application/json

{
  "price": 799,
  "notes": "Upgraded to 4K Ultra HD"
}

### DELETE SUBSCRIPTION
DELETE http://localhost:5000/subscriptions/<SUBSCRIPTION_ID>
Authorization: Bearer <REPLACE_WITH_JWT_TOKEN>

### ADMIN: GET OVERVIEW
GET http://localhost:5000/admin/overview
Authorization: Bearer <REPLACE_WITH_ADMIN_JWT_TOKEN>

### ADMIN: GET ALL USERS
GET http://localhost:5000/admin/users
Authorization: Bearer <REPLACE_WITH_ADMIN_JWT_TOKEN>

### ADMIN: PROMOTE USER TO ADMIN
PUT http://localhost:5000/admin/users/<USER_ID>/role
Authorization: Bearer <REPLACE_WITH_ADMIN_JWT_TOKEN>
Content-Type: application/json

{
  "role": "admin"
}
